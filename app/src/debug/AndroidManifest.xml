<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged only into debug builds. Adds a network security config that permits plain HTTP to the
  local-dev backend addresses (see network_security_config_debug.xml). Release builds get the
  platform's default HTTPS-only behavior, untouched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
