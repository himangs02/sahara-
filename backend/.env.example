# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file (it is already in .gitignore).

# --- Used directly by the FastAPI app (app/core/config.py) ---

# PostgreSQL connection string. If you're using the bundled docker-compose.yml,
# this matches POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD below with host "localhost"
# (or "db" if you're setting DATABASE_URL *inside* the compose network -- the api
# service in docker-compose.yml builds this for you automatically, you don't need to
# set it yourself when running via `docker compose up`):
# DATABASE_URL=postgresql+psycopg://sahara_user:changeme@localhost:5432/sahara
DATABASE_URL=

# Long, random secret used to sign JWTs. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Used only by docker-compose.yml, to build the PostgreSQL container and the
#     DATABASE_URL the `api` service connects with. Not read by the Python app
#     directly. Keep POSTGRES_PASSWORD the same secret quality as JWT_SECRET. ---
POSTGRES_DB=sahara
POSTGRES_USER=sahara_user
POSTGRES_PASSWORD=
